#!/usr/bin/env bash
# Pure-bash test runner. Executes every tests/*.test file and tallies results.
set -u

cd "$(dirname "$0")/.." || exit 1

pass=0
fail=0

# Guard: bash exempts `!`-inverted commands from `set -e`, so a `! cmd`
# assertion asserts NOTHING unless it is a function's final statement — and one
# line added below it silently kills it. 48 such assertions were found inert in
# this suite (2026-09-17), including the guards protecting the WireGuard key in
# ./backup. Use refute / refute_grep from tests/lib/assert instead.
bad=$(grep -nE '(^|[;{&|(])[[:space:]]*![[:space:]]' tests/*.test 2>/dev/null \
        | grep -v '!=' \
        | grep -vE '^[^:]*:[0-9]+:[[:space:]]*#' || true)
if [[ -n "$bad" ]]; then
  echo "refusing to run — negated assertions are exempt from set -e:"
  echo "$bad" | sed 's/^/  /'
  echo ""
  echo "  use:  refute <cmd>              (simple commands)"
  echo "        if <cmd>; then return 1; fi   (subshells, pipelines)"
  exit 1
fi

shopt -s nullglob
for file in tests/*.test; do
  # Each test file defines test_* functions and registers itself via a convention.
  # The runner sources the file in a subshell per test function so state can't leak.
  while IFS= read -r fn; do
    output=$(bash -c "set -e; source 'tests/lib/assert'; source '$file'; $fn" 2>&1)
    status=$?
    if [[ $status -eq 0 ]]; then
      pass=$((pass + 1))
      echo "  PASS  $file::$fn"
    else
      fail=$((fail + 1))
      echo "  FAIL  $file::$fn"
      echo "$output" | sed 's/^/        /'
    fi
  done < <(grep -oE '^test_[a-zA-Z0-9_]+' "$file" | sort -u)
done

echo ""
echo "$pass passed, $fail failed"

if [[ $fail -gt 0 ]]; then
  exit 1
fi
