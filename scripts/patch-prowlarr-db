#!/usr/bin/env bash
# Idempotently rewrite the qBittorrent download-client row in a Prowlarr DB,
# seed the vpn tag + Http indexer proxy (when the vpn profile is active), and
# re-point the FlareSolverr indexer proxy at gluetun.
# Usage: patch-prowlarr-db <db_path> <host> <port> [password]
#
# When [password] is provided, it is also written into Settings.password so
# Prowlarr can authenticate against the qBittorrent WebUI. The password is
# read from stdin if the literal '-' is passed, to avoid leaking it via argv.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common
source "$here/lib/common"

db="${1:-}"
host="${2:-}"
port="${3:-}"
password_arg="${4:-}"

if [[ -z "$db" || -z "$host" || -z "$port" ]]; then
  die "usage: patch-prowlarr-db <db_path> <host> <port> [password|-]"
fi

password=""
if [[ -n "$password_arg" ]]; then
  if [[ "$password_arg" == "-" ]]; then
    password=$(cat)
  else
    password="$password_arg"
  fi
fi

if [[ ! -f "$db" ]]; then
  die "DB not found: $db"
fi

if ! validate_host "$host" 2>/dev/null; then
  die "host must be an IPv4 address or a hostname (got: $host)"
fi

if ! [[ "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
  die "port must be an integer in [1, 65535] (got: $port)"
fi

# Use SQLite's json_set to rewrite host + port (and optionally password) in
# the Settings JSON blob for every row with Implementation='QBittorrent'.
# Idempotent: json_set either adds or updates each field.
#
# Password is shell-escaped for SQL by doubling any single quotes ('' is the
# SQLite literal for a single quote inside a quoted string).
if [[ -n "$password" ]]; then
  esc_pw=$(printf '%s' "$password" | sed "s/'/''/g")
  printf 'UPDATE DownloadClients SET Settings = json_set(Settings, %s, %s, %s, %s, %s, %s) WHERE Implementation = %s;\n' \
    "'\$.host'" "'$host'" \
    "'\$.port'" "$port" \
    "'\$.password'" "'$esc_pw'" \
    "'QBittorrent'" \
    | sqlite3 "$db"
else
  sqlite3 "$db" "UPDATE DownloadClients SET Settings = json_set(Settings, '\$.host', '$host', '\$.port', $port) WHERE Implementation = 'QBittorrent';"
fi

# Verify the update landed.
count=$(sqlite3 "$db" "SELECT COUNT(*) FROM DownloadClients WHERE Implementation='QBittorrent' AND json_extract(Settings, '\$.host') = '$host';")
if [[ "$count" -lt 1 ]]; then
  die "patch did not take effect — no QBittorrent row updated"
fi
if [[ -n "$password" ]]; then
  actual_pw=$(sqlite3 "$db" "SELECT json_extract(Settings, '\$.password') FROM DownloadClients WHERE Implementation='QBittorrent' LIMIT 1;")
  if [[ "$actual_pw" != "$password" ]]; then
    die "password patch did not take effect"
  fi
fi

# --- vpn tag + Http indexer proxy (only when the vpn compose profile is active) ---
#
# Prowlarr now runs on the bridge; only torrent indexers route through
# gluetun's tunnel, via an Http indexer proxy at gluetun:8888 scoped by the
# `vpn` tag. vpn_profile_active() reads COMPOSE_PROFILES from `.env` in the
# current directory — the same file `setup` writes it into, and `setup`
# always runs from the install root, so no path needs passing here.
#
# Keyed on Name='VPN' as well as Implementation='Http' so a user's own
# unrelated Http-type proxy (if they'd set one up for something else) is
# never adopted/overwritten — only the proxy this script itself created.
if vpn_profile_active; then
  sqlite3 "$db" "INSERT INTO Tags (Label) SELECT 'vpn' WHERE NOT EXISTS (SELECT 1 FROM Tags WHERE Label='vpn');"
  vpn_tag=$(sqlite3 "$db" "SELECT Id FROM Tags WHERE Label='vpn' ORDER BY Id LIMIT 1;")
  sqlite3 "$db" "
    INSERT INTO IndexerProxies (Name, Implementation, Settings, ConfigContract, Tags)
    SELECT 'VPN', 'Http', json_object('host','gluetun','port',8888), 'HttpSettings', json_array($vpn_tag)
    WHERE NOT EXISTS (SELECT 1 FROM IndexerProxies WHERE Implementation='Http' AND Name='VPN');"
  sqlite3 "$db" "
    UPDATE IndexerProxies
       SET Settings = json_set(Settings,'\$.host','gluetun','\$.port',8888),
           Tags = json_array($vpn_tag)
     WHERE Implementation='Http' AND Name='VPN';"
  log_ok "prowlarr.db" "vpn tag (id $vpn_tag) + Http proxy -> gluetun:8888"
fi

# --- FlareSolverr proxy: always re-point at gluetun ---
#
# Prowlarr no longer shares byparr's network namespace (it's on the bridge),
# so `http://localhost:8191/` now resolves to Prowlarr itself. Use json_set
# so the sibling `requestTimeout` field survives untouched.
sqlite3 "$db" "
  UPDATE IndexerProxies
     SET Settings = json_set(Settings,'\$.host','http://gluetun:8191/')
   WHERE Implementation='FlareSolverr';"
