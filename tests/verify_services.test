#!/usr/bin/env bash
set -u

# shellcheck source=../scripts/lib/common
source "./scripts/lib/common"

# Keep the poll loop fast; these tests never touch a real container.
export HTTP_POLL_INTERVAL=1
export HTTP_PROBE_TIMEOUT=1

# Replace the docker-exec probe with a table-driven stub. RESPONSES maps a
# substring of the probed URL to the body to return; an unmapped URL simulates
# an unreachable service (non-zero exit, as wget would give).
declare -A RESPONSES=()
http_probe_in_container() {
  local url="$2"
  local key
  for key in "${!RESPONSES[@]}"; do
    if [[ "$url" == *"$key"* ]]; then
      echo "${RESPONSES[$key]}"
      return 0
    fi
  done
  return 1
}

# The vpn profile defaults to INACTIVE for these tests. Without this, the suite
# would read whatever COMPOSE_PROFILES happens to be in a developer's gitignored
# .env, so a checkout used to run the stack would test differently from a fresh
# clone. Tests that need byparr in play turn it on explicitly.
vpn_profile_active() { return 1; }

_all_healthy() {
  RESPONSES=(
    ["9696/ping"]='{"status": "OK"}'
    ["8191/health"]='{"msg":"Byparr is working!","version":"3.0.4"}'
    ["mode=version"]='{"version":"5.1.2"}'
  )
}

# --- wait_for_http ---

test_wait_for_http_succeeds_when_marker_present() {
  _all_healthy
  wait_for_http gluetun "http://127.0.0.1:9696/ping" "OK" 5
}

test_wait_for_http_fails_when_service_unreachable() {
  RESPONSES=()
  refute wait_for_http gluetun "http://127.0.0.1:9696/ping" "OK" 2
}

test_wait_for_http_fails_when_marker_absent() {
  # Service answers, but with the wrong body — a 200 from the wrong process
  # must not count as healthy.
  RESPONSES=(["9696/ping"]='<html>404 not found</html>')
  refute wait_for_http gluetun "http://127.0.0.1:9696/ping" "OK" 2
}

# --- verify_services ---

test_verify_services_passes_when_all_three_respond() {
  _all_healthy
  verify_services 5 >/dev/null 2>&1
}

test_verify_services_fails_when_prowlarr_down() {
  _all_healthy
  unset 'RESPONSES[9696/ping]'
  refute verify_services 2 >/dev/null 2>&1
}

test_verify_services_fails_when_byparr_down() {
  # The regression this gate exists for: before it, a broken solver passed the
  # upgrade check and was never rolled back. Byparr is only probed under the
  # vpn profile, so this assertion needs it active.
  _all_healthy
  unset 'RESPONSES[8191/health]'
  vpn_profile_active() { return 0; }
  refute verify_services 2 >/dev/null 2>&1
}

test_verify_services_fails_when_sabnzbd_down() {
  _all_healthy
  unset 'RESPONSES[mode=version]'
  refute verify_services 2 >/dev/null 2>&1
}

test_verify_services_reports_every_failure_not_just_the_first() {
  # All three down: the output must name all three, so one run tells the
  # operator everything that is broken. That only makes sense with byparr in
  # play at all, so the vpn profile must read as active for this assertion.
  RESPONSES=()
  vpn_profile_active() { return 0; }
  local out
  out=$(verify_services 2 2>&1) || true
  grep -q "prowlarr" <<<"$out" && grep -q "byparr" <<<"$out" && grep -q "sabnzbd" <<<"$out"
}

test_prowlarr_probe_targets_the_prowlarr_container() {
  _all_healthy
  # Answer :9696 ONLY when probed in the prowlarr container. If verify_services
  # still probes through gluetun, prowlarr reads as down and this fails.
  http_probe_in_container() {
    local container="$1" url="$2"
    if [[ "$url" == *"9696/ping"* ]]; then
      [[ "$container" == "prowlarr" ]] || return 1
      echo '{"status": "OK"}'
      return 0
    fi
    local key
    for key in "${!RESPONSES[@]}"; do
      [[ "$url" == *"$key"* ]] && { echo "${RESPONSES[$key]}"; return 0; }
    done
    return 1
  }
  verify_services 5 >/dev/null 2>&1
}

test_byparr_is_not_probed_without_the_vpn_profile() {
  # byparr is absent from the project entirely when the profile is off, so a
  # non-answering solver must not be a failure.
  _all_healthy
  unset 'RESPONSES[8191/health]'
  vpn_profile_active() { return 1; }
  verify_services 2 >/dev/null 2>&1
}

test_byparr_is_probed_under_the_vpn_profile() {
  _all_healthy
  unset 'RESPONSES[8191/health]'
  vpn_profile_active() { return 0; }
  refute verify_services 2 >/dev/null 2>&1
}

test_verify_services_tolerates_sabnzbd_without_usenet_credentials() {
  # SABnzbd's WebUI comes up whether or not news-server creds are set, and
  # running without them is supported — the probe must not assert on them.
  _all_healthy
  RESPONSES["mode=version"]='{"version":"5.1.2"}'
  verify_services 5 >/dev/null 2>&1
}

# --- timeout budget ---

test_wait_for_http_respects_its_wall_clock_budget() {
  # Regression: the budget used to count only the sleeps, so a probe that blocked
  # was invisible to it and the effective timeout ballooned to several times what
  # the caller asked for. In the upgrade gate that delayed a rollback by minutes.
  # A probe that burns 2s per call must still not overrun a 6s budget by much.
  http_probe_in_container() { sleep 2; return 1; }
  local start elapsed
  start=$(date +%s)
  refute wait_for_http gluetun "http://127.0.0.1:9696/ping" "OK" 6
  elapsed=$(( $(date +%s) - start ))
  # Allow one in-flight probe to finish past the deadline, but nothing like the
  # old ~3x overrun.
  [[ "$elapsed" -le 10 ]]
}

test_wait_for_http_probes_at_least_once_with_a_tiny_budget() {
  # A budget too small for a second attempt must still make the first one,
  # rather than returning failure without ever probing.
  # The counter lives in a file because the probe runs inside a command
  # substitution, so a shell variable would be incremented in a subshell.
  local counter; counter=$(mktemp)
  http_probe_in_container() { echo x >> "$counter"; echo "OK"; return 0; }
  wait_for_http gluetun "http://127.0.0.1:9696/ping" "OK" 1
  local calls; calls=$(wc -l < "$counter")
  rm -f "$counter"
  [[ "$calls" -ge 1 ]]
}
