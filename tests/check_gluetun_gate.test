#!/usr/bin/env bash
set -u
source "./scripts/lib/common"

# Stub the health lookup; the real one shells out to docker inspect.
# NOTE: a nested `gluetun_health_status() { echo "$1"; }` would echo its OWN
# $1 (empty, since assert_tunnel_healthy calls it with no args) rather than
# closing over _with_health's argument — bash function bodies aren't
# evaluated at definition time, so "$1" resolves against whatever positional
# params are in scope when the nested function is later invoked. Route
# through a variable instead so the stub actually returns the intended status.
_with_health() { _stub_health_status="$1"; gluetun_health_status() { echo "$_stub_health_status"; }; }

test_tunnel_gate_passes_when_gluetun_healthy() {
  vpn_profile_active() { return 0; }
  _with_health healthy
  assert_tunnel_healthy >/dev/null 2>&1
}

test_tunnel_gate_fails_when_gluetun_unhealthy() {
  vpn_profile_active() { return 0; }
  _with_health unhealthy
  refute assert_tunnel_healthy >/dev/null 2>&1
}

test_tunnel_gate_fails_when_gluetun_missing() {
  vpn_profile_active() { return 0; }
  _with_health missing
  refute assert_tunnel_healthy >/dev/null 2>&1
}

test_tunnel_gate_is_skipped_without_the_vpn_profile() {
  # No VPN configured: gluetun is absent by design, so its absence is not a fault.
  vpn_profile_active() { return 1; }
  _with_health missing
  assert_tunnel_healthy >/dev/null 2>&1
}

# --- wait_for_tunnel_if_configured ---
# Regression: ./update waited for gluetun unconditionally, so a usenet-only
# install failed verification after every upgrade and rolled itself back.

test_tunnel_wait_is_skipped_without_the_vpn_profile() {
  vpn_profile_active() { return 1; }
  wait_for_gluetun_healthy() { return 1; }   # would fail the wait if consulted
  wait_for_tunnel_if_configured 1
}

test_tunnel_wait_fails_when_the_tunnel_never_comes_up() {
  vpn_profile_active() { return 0; }
  wait_for_gluetun_healthy() { return 1; }
  refute wait_for_tunnel_if_configured 1
}

test_tunnel_wait_succeeds_when_the_tunnel_is_healthy() {
  vpn_profile_active() { return 0; }
  wait_for_gluetun_healthy() { return 0; }
  wait_for_tunnel_if_configured 1
}
